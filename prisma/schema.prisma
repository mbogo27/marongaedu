generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Role {
  LEARNER
  ADMIN
  // INSTRUCTOR can be added later (multi-instructor extensibility, spec v1 §9).
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  VIDEO
  READING
  QUIZ
  RESOURCE
}

enum QuestionType {
  SINGLE
  MULTI
  TRUEFALSE
}

enum EnrollmentSource {
  PURCHASE
  FREE
  MANUAL
  COUPON
}

enum EnrollmentStatus {
  ACTIVE
  REVOKED
}

enum PaymentMethod {
  MPESA
  CARD
  FREE
  MANUAL
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  FLAGGED
}

enum ContactStatus {
  NEW
  READ
  REPLIED
}

enum TokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
  CHANGE_EMAIL
  ADMIN_INVITE
  NEWSLETTER_OPTIN
}

enum EmailStatus {
  SENT
  FAILED
  SKIPPED
}

// ---------- Identity ----------

model User {
  id                String     @id @default(cuid())
  name              String
  email             String     @unique
  role              Role       @default(LEARNER)
  status            UserStatus @default(ACTIVE)
  avatarUrl         String?
  bio               String?
  emailVerifiedAt   DateTime?  @db.Timestamptz
  notificationPrefs Json       @default("{}")
  lastLoginAt       DateTime?  @db.Timestamptz
  createdAt         DateTime   @default(now()) @db.Timestamptz
  updatedAt         DateTime   @updatedAt @db.Timestamptz
  deletedAt         DateTime?  @db.Timestamptz

  accounts        Account[]
  sessions        Session[]
  tokens          VerificationToken[]
  coursesTaught   Course[]            @relation("InstructorCourses")
  enrollments     Enrollment[]
  reviews         Review[]
  reviewVotes     ReviewVote[]
  payments        Payment[]
  wishlist        Wishlist[]
  notes           LessonNote[]
  couponUsages    CouponUsage[]
  quizAttempts    QuizAttempt[]
  comments        LessonComment[]
  adminNotes      StudentNote[]       @relation("StudentNoteSubject")
  authoredNotes   StudentNote[]       @relation("StudentNoteAuthor")

  @@index([role])
  @@index([createdAt])
}

/// One row per sign-in method. Email/password is providerId "credential"
/// (providerAccountId = userId, passwordHash set); Google would be "google"
/// with the Google subject id and no passwordHash (spec §3.10).
model Account {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId        String
  providerAccountId String
  passwordHash      String?
  createdAt         DateTime @default(now()) @db.Timestamptz

  @@unique([providerId, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String   @unique
  remember     Boolean  @default(false)
  expiresAt    DateTime @db.Timestamptz
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now()) @db.Timestamptz
  lastActiveAt DateTime @default(now()) @db.Timestamptz

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  id         String       @id @default(cuid())
  userId     String?
  user       User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  identifier String // email address the token was issued for
  purpose    TokenPurpose
  tokenHash  String       @unique
  expiresAt  DateTime     @db.Timestamptz
  usedAt     DateTime?    @db.Timestamptz
  meta       Json?
  createdAt  DateTime     @default(now()) @db.Timestamptz

  @@index([userId, purpose])
  @@index([identifier, purpose])
}

model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime @db.Timestamptz

  @@index([windowStart])
}

// ---------- Catalog ----------

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  iconUrl     String?
  sortOrder   Int      @default(0)
  courses     Course[]
}

model Course {
  id                 String       @id @default(cuid())
  title              String
  slug               String       @unique
  subtitle           String?
  description        String // sanitized HTML
  shortDescription   String
  categoryId         String
  category           Category     @relation(fields: [categoryId], references: [id])
  instructorId       String
  instructor         User         @relation("InstructorCourses", fields: [instructorId], references: [id])
  level              Level
  language           String       @default("English")
  priceKes           Int          @default(0)
  salePriceKes       Int?
  saleEndsAt         DateTime?    @db.Timestamptz
  isFree             Boolean      @default(false)
  thumbnailUrl       String       @default("")
  previewVideoUrl    String       @default("")
  status             CourseStatus @default(DRAFT)
  isFeatured         Boolean      @default(false)
  requireSequential  Boolean      @default(false)
  enrollmentCap      Int?
  enrollmentOpensAt  DateTime?    @db.Timestamptz
  enrollmentClosesAt DateTime?    @db.Timestamptz
  certificateTemplate String      @default("default")
  metaTitle          String?
  metaDescription    String?
  ogImageUrl         String?
  createdAt          DateTime     @default(now()) @db.Timestamptz
  updatedAt          DateTime     @updatedAt @db.Timestamptz
  publishedAt        DateTime?    @db.Timestamptz
  deletedAt          DateTime?    @db.Timestamptz

  outcomes      CourseOutcome[]
  requirements  CourseRequirement[]
  audience      CourseAudience[]
  modules       Module[]
  enrollments   Enrollment[]
  reviews       Review[]
  payments      Payment[]
  wishlist      Wishlist[]
  couponCourses CouponCourse[]
  slugRedirects SlugRedirect[]

  @@index([categoryId])
  @@index([instructorId])
  @@index([status, deletedAt])
}

model SlugRedirect {
  fromSlug String @id
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model CourseOutcome {
  id        String @id @default(cuid())
  courseId  String
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  text      String
  sortOrder Int    @default(0)

  @@index([courseId])
}

model CourseRequirement {
  id        String @id @default(cuid())
  courseId  String
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  text      String
  sortOrder Int    @default(0)

  @@index([courseId])
}

model CourseAudience {
  id        String @id @default(cuid())
  courseId  String
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  text      String
  sortOrder Int    @default(0)

  @@index([courseId])
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  sortOrder   Int      @default(0)
  lessons     Lesson[]

  @@index([courseId])
}

model Lesson {
  id              String     @id @default(cuid())
  moduleId        String
  module          Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title           String
  type            LessonType
  durationSeconds Int        @default(0)
  /// Shape varies by type — see src/lib/content-types.ts
  content         Json       @default("{}")
  passMark        Int        @default(70) // quiz lessons only
  isFreePreview   Boolean    @default(false)
  sortOrder       Int        @default(0)

  quizQuestions QuizQuestion[]
  progress      LessonProgress[]
  notes         LessonNote[]
  attempts      QuizAttempt[]
  comments      LessonComment[]

  @@index([moduleId])
}

model QuizQuestion {
  id          String       @id @default(cuid())
  lessonId    String
  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  question    String
  type        QuestionType
  explanation String?
  sortOrder   Int          @default(0)
  options     QuizOption[]

  @@index([lessonId])
}

model QuizOption {
  id         String       @id @default(cuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean      @default(false)
  sortOrder  Int          @default(0)

  @@index([questionId])
}

// ---------- Enrollment / progress ----------

model Enrollment {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status          EnrollmentStatus @default(ACTIVE)
  enrolledAt      DateTime         @default(now()) @db.Timestamptz
  completedAt     DateTime?        @db.Timestamptz
  revokedAt       DateTime?        @db.Timestamptz
  progressPercent Int              @default(0)
  lastLessonId    String?
  source          EnrollmentSource

  lessonProgress LessonProgress[]
  quizAttempts   QuizAttempt[]
  payments       Payment[]
  certificate    Certificate?

  @@unique([userId, courseId])
  @@index([courseId])
}

model LessonProgress {
  id                  String     @id @default(cuid())
  enrollmentId        String
  enrollment          Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId            String
  lesson              Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed           Boolean    @default(false)
  completedAt         DateTime?  @db.Timestamptz
  lastPositionSeconds Int        @default(0)
  bestScorePercent    Int?
  updatedAt           DateTime   @updatedAt @db.Timestamptz

  @@unique([enrollmentId, lessonId])
  @@index([lessonId])
}

model QuizAttempt {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  answers      Json
  scorePercent Int
  passed       Boolean
  createdAt    DateTime   @default(now()) @db.Timestamptz

  @@index([enrollmentId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

model LessonNote {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId              String
  lesson                Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  content               String
  videoTimestampSeconds Int?
  createdAt             DateTime @default(now()) @db.Timestamptz
  updatedAt             DateTime @updatedAt @db.Timestamptz

  @@index([userId, lessonId])
  @@index([lessonId])
}

/// Per-lesson discussion (feature-flagged: FEATURE_DISCUSSIONS).
model LessonComment {
  id        String          @id @default(cuid())
  lessonId  String
  lesson    Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    LessonComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   LessonComment[] @relation("CommentReplies")
  body      String
  hiddenAt  DateTime?       @db.Timestamptz
  createdAt DateTime        @default(now()) @db.Timestamptz

  @@index([lessonId])
  @@index([userId])
  @@index([parentId])
}

// ---------- Reviews ----------

model Review {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  rating          Int
  text            String
  status          ReviewStatus @default(PUBLISHED)
  instructorReply String?
  repliedAt       DateTime?    @db.Timestamptz
  createdAt       DateTime     @default(now()) @db.Timestamptz
  updatedAt       DateTime     @updatedAt @db.Timestamptz
  deletedAt       DateTime?    @db.Timestamptz

  votes ReviewVote[]

  @@unique([userId, courseId])
  @@index([courseId, status])
}

model ReviewVote {
  reviewId String
  review   Review  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  helpful  Boolean

  @@id([reviewId, userId])
  @@index([userId])
}

// ---------- Payments / coupons ----------

model Payment {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollmentId   String?
  enrollment     Enrollment?   @relation(fields: [enrollmentId], references: [id])
  idempotencyKey String        @unique
  subtotalKes    Int           @default(0)
  discountKes    Int           @default(0)
  amountKes      Int
  currency       String        @default("KES")
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  reference      String?
  failureReason  String?
  phone          String?
  cardBrand      String?
  cardLast4      String?
  couponCode     String?
  invoiceNumber  String?       @unique
  /// Provider-specific data. Never contains full card numbers or CVV.
  payload        Json?
  createdAt      DateTime      @default(now()) @db.Timestamptz
  updatedAt      DateTime      @updatedAt @db.Timestamptz
  refundedAt     DateTime?     @db.Timestamptz

  @@index([userId])
  @@index([courseId])
  @@index([enrollmentId])
  @@index([status, createdAt])
}

model Sequence {
  name  String @id
  value Int    @default(0)
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Int
  usageLimit    Int?
  perUserLimit  Int?
  startsAt      DateTime?    @db.Timestamptz
  endsAt        DateTime?    @db.Timestamptz
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now()) @db.Timestamptz

  courses CouponCourse[]
  usages  CouponUsage[]
}

model CouponCourse {
  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([couponId, courseId])
  @@index([courseId])
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentId String?
  usedAt    DateTime @default(now()) @db.Timestamptz

  @@index([couponId])
  @@index([userId])
}

model Wishlist {
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  addedAt  DateTime @default(now()) @db.Timestamptz

  @@id([userId, courseId])
  @@index([courseId])
}

// ---------- Certificates ----------

model Certificate {
  id           String     @id @default(uuid())
  /// Short human code, e.g. DENT-7K3Q-9XPA — what /verify/:code takes.
  code         String     @unique
  enrollmentId String     @unique
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  issuedAt     DateTime   @default(now()) @db.Timestamptz
  templateId   String     @default("default")
  /// Frozen at issue time: learnerName, courseTitle, completedAt, instructorName.
  snapshot     Json
  pdfKey       String?
  revokedAt    DateTime?  @db.Timestamptz
}

// ---------- Site content / ops ----------

model ContactSubmission {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now()) @db.Timestamptz

  @@index([status])
}

model Subscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  confirmedAt      DateTime? @db.Timestamptz
  unsubscribedAt   DateTime? @db.Timestamptz
  unsubscribeToken String    @unique @default(cuid())
  createdAt        DateTime  @default(now()) @db.Timestamptz
}

model Faq {
  id        String @id @default(cuid())
  question  String
  answer    String
  sortOrder Int    @default(0)
}

model Notification {
  id        String    @id @default(cuid())
  type      String
  payload   Json
  readAt    DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @db.Timestamptz

  @@index([createdAt])
}

model Setting {
  key   String @id
  value Json
}

model StudentNote {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation("StudentNoteSubject", fields: [studentId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("StudentNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([studentId])
  @@index([authorId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now()) @db.Timestamptz

  @@index([action])
  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model EmailLog {
  id                String      @id @default(cuid())
  to                String
  template          String
  subject           String
  status            EmailStatus
  providerMessageId String?
  error             String?
  /// Only populated by the console provider so tests/dev can read links.
  textBody          String?
  createdAt         DateTime    @default(now()) @db.Timestamptz

  @@index([to, createdAt])
  @@index([status])
}
