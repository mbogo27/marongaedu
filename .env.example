# Copy to .env for local development. Every key is validated at boot by
# src/lib/env.ts (Zod) — a bad value fails fast with a readable message.
# Empty values are treated as unset.

# --- Core ---
# PostgreSQL. `docker compose up -d` starts the one in docker-compose.yml.
DATABASE_URL="postgresql://maronga:maronga@localhost:5432/maronga"
# Public base URL: used in emails, certificate verify links, sitemap, OG tags.
APP_URL="http://localhost:3000"
# Signs/derives secrets (signed media URLs, etc.). Generate: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-32chars+"

# --- Google sign-in (designed for, not built — see README "Enabling Google") ---
AUTH_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email ---
EMAIL_PROVIDER=console            # console | resend
RESEND_API_KEY=
EMAIL_FROM="Maronga Dental Academy <no-reply@example.com>"
ADMIN_NOTIFY_EMAIL=

# --- Storage ---
STORAGE_PROVIDER=local            # local | s3
STORAGE_LOCAL_DIR=.storage        # local provider only (gitignored)
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PUBLIC=
S3_BUCKET_PRIVATE=
S3_PUBLIC_BASE_URL=

MAX_VIDEO_MB=2048                 # per-upload cap for lesson videos
MAX_FILE_MB=50                    # per-upload cap for everything else

# --- Payments ---
PAYMENTS_MODE=simulated           # simulated is the only mode implemented

# --- Rate limiting ---
RATE_LIMIT_PROVIDER=db            # memory (dev only) | db | upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Bot protection (optional) ---
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Observability / analytics / flags ---
ANALYTICS_PROVIDER=console        # console | posthog | plausible | ga4
FEATURE_DISCUSSIONS=false
SENTRY_DSN=
