# SQLite file, relative to the project root (Prisma 7 driver adapters resolve
# it relative to process.cwd(), not the schema file's directory).
DATABASE_URL="file:./prisma/dev.db"

# Used to sign session JWTs (jose). Generate your own with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Display-only conversion rate for the KES/USD toggle. Charges are always in KES (stubbed).
USD_KES_RATE="129"

# Used to build absolute URLs (certificate verification links, OG tags).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
